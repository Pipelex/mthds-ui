{
  "data_pipeline.build_index": {
    "inputs": {
      "embeddings": {
        "concept_ref": "data_pipeline.Embedding",
        "json_schema": {
          "items": {
            "description": "Vector embedding of text",
            "properties": {
              "text": {
                "description": "The text",
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "title": "data_pipeline__Embedding",
            "type": "object"
          },
          "type": "array"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "data_pipeline.VectorIndex",
      "multiplicity": "single",
      "optional": false
    }
  },
  "data_pipeline.chunk_text": {
    "inputs": {
      "clean_text": {
        "concept_ref": "data_pipeline.CleanText",
        "json_schema": {
          "description": "Text that has been cleaned and normalized",
          "properties": {
            "text": {
              "description": "The text",
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "data_pipeline__CleanText",
          "type": "object"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "data_pipeline.TextChunk",
      "multiplicity": "variable",
      "optional": false
    }
  },
  "data_pipeline.clean_text": {
    "inputs": {
      "pages": {
        "concept_ref": "native.Page",
        "json_schema": {
          "items": {
            "$defs": {
              "ImageContent": {
                "properties": {
                  "caption": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The caption of the image",
                    "title": "Caption"
                  },
                  "filename": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The original filename of the image",
                    "title": "Filename"
                  },
                  "height": {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The height of the image, in pixels",
                    "title": "Height"
                  },
                  "mime_type": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The MIME type of the image",
                    "title": "Mime Type"
                  },
                  "public_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The public URL of the image",
                    "title": "Public Url"
                  },
                  "source_negative_prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The source negative prompt of the image",
                    "title": "Source Negative Prompt"
                  },
                  "source_prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The source prompt of the image",
                    "title": "Source Prompt"
                  },
                  "url": {
                    "description": "The image URL: a storage URI, an HTTP(S) URL, or a base64 data URL",
                    "title": "Url",
                    "type": "string"
                  },
                  "width": {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The width of the image, in pixels",
                    "title": "Width"
                  }
                },
                "required": [
                  "url"
                ],
                "title": "ImageContent",
                "type": "object"
              },
              "TextAndImagesContent": {
                "properties": {
                  "images": {
                    "anyOf": [
                      {
                        "items": {
                          "$ref": "#/$defs/ImageContent"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "A list of images that were extracted from the text",
                    "title": "Images"
                  },
                  "raw_html": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The raw HTML of the fetched page, if requested",
                    "title": "Raw Html"
                  },
                  "text": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/TextContent"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "A text content"
                  }
                },
                "title": "TextAndImagesContent",
                "type": "object"
              },
              "TextContent": {
                "properties": {
                  "text": {
                    "description": "The text",
                    "title": "Text",
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "title": "TextContent",
                "type": "object"
              }
            },
            "properties": {
              "page_view": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ImageContent"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The screenshot of the page"
              },
              "text_and_images": {
                "$ref": "#/$defs/TextAndImagesContent",
                "description": "The text and images content extracted from the page"
              }
            },
            "required": [
              "text_and_images"
            ],
            "title": "PageContent",
            "type": "object"
          },
          "type": "array"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "data_pipeline.CleanText",
      "multiplicity": "single",
      "optional": false
    }
  },
  "data_pipeline.embed_chunks": {
    "inputs": {
      "chunks": {
        "concept_ref": "data_pipeline.TextChunk",
        "json_schema": {
          "items": {
            "description": "A segment of text split for processing",
