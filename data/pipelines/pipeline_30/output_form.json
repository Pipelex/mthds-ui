    }
  },
  "candidate_screening.generate_interview_questions": {
    "field": {
      "concept_ref": "candidate_screening.InterviewQuestion",
      "description": "A tailored interview question for a candidate based on their profile and the job requirements.",
      "item": {
        "concept_ref": "candidate_screening.InterviewQuestion",
        "description": "A tailored interview question for a candidate based on their profile and the job requirements.",
        "kind": "prose",
        "refines": [
          "native.Text"
        ],
        "required": true
      },
      "item_count": 5,
      "kind": "list",
      "name": "output",
      "refines": [
        "native.Text"
      ],
      "required": true
    }
  },
  "candidate_screening.route_on_match": {
