      "kind": "unknown",
      "name": "output",
      "required": true
    }
  },
  "rag.rag_pipeline": {
    "field": {
      "concept_ref": "rag.Answer",
      "description": "Generated answer with citations",
      "kind": "prose",
      "name": "output",
      "refines": [
        "native.Text"
      ],
      "required": true
    }
  },
  "rag.rerank_results": {
    "field": {
      "concept_ref": "rag.RankedContext",
      "description": "Reranked and filtered context passages",
      "kind": "prose",
      "name": "output",
      "refines": [
        "native.Text"
      ],
      "required": true
    }
  },
  "rag.vector_search": {
    "field": {
      "concept_ref": "native.SearchResult",
      "description": "A search result with answer and sources",
      "fields": [
        {
          "description": "The answer to the search query",
          "kind": "text",
          "name": "answer",
          "required": true
        },
        {
          "concept_ref": "native.Document",
          "description": "The source documents supporting the answer",
          "item": {
            "concept_ref": "native.Document",
            "description": "A document",
            "kind": "document",
            "required": true
          },
          "kind": "list",
          "name": "sources",
          "required": true
        }
      ],
      "kind": "object",
      "name": "output",
      "required": true
