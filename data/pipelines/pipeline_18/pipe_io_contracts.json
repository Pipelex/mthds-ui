  "code_review.fetch_diff": {
    "inputs": {
      "pr_url": {
        "concept_ref": "native.Text",
        "json_schema": {
          "properties": {
            "text": {
              "description": "The text",
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "TextContent",
          "type": "object"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "native.SearchResult",
      "multiplicity": "single",
      "optional": false
    }
