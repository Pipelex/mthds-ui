              },
              "description": {
                "description": "Description of the finding",
                "title": "Description",
                "type": "string"
              },
              "line_ref": {
                "description": "Line reference in the diff",
                "title": "Line Ref",
                "type": "string"
              },
              "severity": {
                "description": "Severity level",
                "enum": [
                  "critical",
                  "warning",
                  "info"
                ],
                "title": "Severity",
                "type": "string"
              }
            },
            "required": [
              "severity",
              "category",
              "description",
              "line_ref"
            ],
            "title": "code_review__ReviewFinding",
            "type": "object"
          },
          "type": "array"
        },
        "optional": false
      },
