    "inputs": {
      "logic_findings": {
        "concept_ref": "code_review.ReviewFinding",
        "json_schema": {
          "items": {
            "description": "A finding from code review",
            "properties": {
              "category": {
                "description": "Finding category",
                "title": "Category",
