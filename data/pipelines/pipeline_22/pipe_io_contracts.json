          "properties": {
            "filename": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The original filename of the document",
              "title": "Filename"
            },
            "mime_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The MIME type of the document",
              "title": "Mime Type"
            },
            "public_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The public HTTPS URL of the document",
              "title": "Public Url"
            },
            "snippet": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A text snippet or excerpt from the document",
              "title": "Snippet"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The title of the document or source",
              "title": "Title"
            },
            "url": {
              "description": "The document URL: a storage URI, an HTTP(S) URL, or a base64 data URL",
              "title": "Url",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "DocumentContent",
          "type": "object"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "content_distribution.Analysis",
      "multiplicity": "single",
      "optional": false
    }
  },
