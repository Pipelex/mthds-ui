    }
  },
  "availability.reply_now": {
    "inputs": {
      "checks": {
        "concept_ref": "availability.SlotCheck",
        "json_schema": {
          "items": {
            "description": "Whether one proposed date has a free slot",
            "properties": {
              "day": {
                "description": "The date that was checked, in ISO 8601",
                "title": "Day",
                "type": "string"
              },
              "is_free": {
                "description": "Whether the calendar is free that day",
                "title": "Is Free",
                "type": "boolean"
              },
              "note": {
                "description": "What else is on the calendar that day",
                "title": "Note",
                "type": "string"
              }
            },
            "required": [
              "day",
              "is_free",
              "note"
            ],
            "title": "availability__SlotCheck",
            "type": "object"
          },
          "type": "array"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "availability.Reply",
      "multiplicity": "single",
      "optional": false
    }
  },
