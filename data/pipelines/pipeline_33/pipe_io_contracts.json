                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The time of day, in ISO 8601 (e.g. 15:40:00, or 15:40:00+02:00 with a UTC offset). Include it only when the source states a time — never invent a time. Keep the UTC offset exactly when the source states one.",
                "title": "Time"
              }
            },
            "required": [
              "date"
            ],
            "title": "DateContent",
            "type": "object"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/DateContent"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ListContent[DateContent]",
        "type": "object"
      },
      "multiplicity": "variable",
      "optional": false
    }
  },
