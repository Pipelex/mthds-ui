{
  "availability.check_day": {
    "inputs": {
      "day": {
        "concept_ref": "native.Date",
        "item_count": null,
        "json_schema": {
          "description": "A calendar date, optionally with a time of day — as precise as its source states.",
          "properties": {
            "date": {
              "description": "The calendar date, in ISO 8601 (e.g. 2026-07-07). Always required.",
              "format": "date",
              "title": "Date",
              "type": "string"
            },
            "time": {
              "anyOf": [
                {
                  "format": "time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The time of day, in ISO 8601 (e.g. 15:40:00, or 15:40:00+02:00 with a UTC offset). Include it only when the source states a time — never invent a time. Keep the UTC offset exactly when the source states one.",
              "title": "Time"
            }
          },
          "required": [
            "date"
          ],
          "title": "native.Date",
          "type": "object"
        },
        "multiplicity": "single",
        "presence": "plain"
      }
    },
    "output": {
      "concept_ref": "availability.SlotCheck",
      "item_count": null,
      "json_schema": {
        "description": "Whether one proposed date has a free slot",
        "properties": {
          "day": {
            "description": "The date that was checked, in ISO 8601",
            "title": "Day",
            "type": "string"
          },
          "is_free": {
            "description": "Whether the calendar is free that day",
            "title": "Is Free",
            "type": "boolean"
          },
          "note": {
            "description": "What else is on the calendar that day",
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "day",
          "is_free",
          "note"
        ],
        "title": "availability.SlotCheck",
        "type": "object"
      },
      "multiplicity": "single",
      "optional": false
    }
  },
