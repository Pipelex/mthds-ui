              "title": "Mime Type"
            },
            "public_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The public URL of the image",
              "title": "Public Url"
            },
            "source_negative_prompt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The source negative prompt of the image",
              "title": "Source Negative Prompt"
            },
            "source_prompt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The source prompt of the image",
              "title": "Source Prompt"
            },
            "url": {
              "description": "The image URL: a storage URI, an HTTP(S) URL, or a base64 data URL",
              "title": "Url",
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The width of the image, in pixels",
              "title": "Width"
            }
          },
          "required": [
            "url"
          ],
          "title": "ImageContent",
          "type": "object"
        },
        "optional": false
      },
      "gamma_result": {
        "concept_ref": "data_processing.ProcessedData",
        "json_schema": {
          "description": "Data processed through one pathway",
          "properties": {
            "text": {
              "description": "The text",
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "title": "data_processing__ProcessedData",
          "type": "object"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "data_processing.MergedResult",
      "multiplicity": "single",
      "optional": false
    }
