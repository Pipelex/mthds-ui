            "answer": {
              "description": "The answer to the search query",
              "title": "Answer",
              "type": "string"
            },
            "sources": {
              "description": "The source documents supporting the answer",
              "items": {
                "$ref": "#/$defs/DocumentContent"
              },
              "title": "Sources",
              "type": "array"
            }
          },
          "required": [
            "answer"
          ],
          "title": "SearchResultContent",
          "type": "object"
        },
        "optional": false
      },
      "delta_result": {
        "concept_ref": "native.Image",
        "json_schema": {
          "properties": {
            "caption": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
