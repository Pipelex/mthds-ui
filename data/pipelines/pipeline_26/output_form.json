    }
  },
  "cv_matching.generate_interview_questions": {
    "field": {
      "concept_ref": "cv_matching.InterviewQuestion",
      "description": "A tailored interview question for a candidate",
      "item": {
        "concept_ref": "cv_matching.InterviewQuestion",
        "description": "A tailored interview question for a candidate",
        "kind": "prose",
        "refines": [
          "native.Text"
        ],
        "required": true
      },
