  "cv_matching.generate_interview_questions": {
    "inputs": {
      "evaluation": {
        "concept_ref": "cv_matching.CvEvaluation",
        "json_schema": {
          "description": "Evaluation of a CV against a job offer",
          "properties": {
            "candidate_name": {
              "description": "Name of the candidate",
              "title": "Candidate Name",
              "type": "string"
            },
            "gaps": {
              "anyOf": [
                {
                  "items": {},
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Missing qualifications relative to the job",
              "title": "Gaps"
            },
            "match": {
              "description": "Whether the CV matches: yes or no",
              "enum": [
                "yes",
                "no"
              ],
              "title": "Match",
              "type": "string"
            },
            "match_score": {
              "description": "Match score from 0 to 100",
              "title": "Match Score",
              "type": "number"
            },
            "strengths": {
              "anyOf": [
                {
                  "items": {},
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Key strengths relative to the job",
              "title": "Strengths"
            },
            "summary": {
              "description": "Overall evaluation summary",
              "title": "Summary",
              "type": "string"
            }
          },
          "required": [
            "candidate_name",
            "match",
            "match_score",
            "summary"
          ],
          "title": "cv_matching__CvEvaluation",
          "type": "object"
        },
        "optional": false
      }
    },
    "output": {
      "concept_ref": "cv_matching.InterviewQuestion",
      "multiplicity": "variable",
      "optional": false
    }
  },
